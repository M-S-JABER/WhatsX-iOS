# Fastfile — خط البناء والنشر لـ WhatsX
#
# كل هذه الـ lanes مصمَّمة للعمل داخل runner من نوع macOS على GitHub Actions.
# لا شيء منها يحتاج جهاز Mac محلياً، ولا Xcode على جهازك.
#
# ────────────────────────────────────────────────────────────────────────
#  الـ lanes المتاحة
# ────────────────────────────────────────────────────────────────────────
#   fastlane build                 بناء غير موقّع للتحقق السريع (لا يحتاج أي سر)
#   fastlane setup_certificates    سحب الشهادات من مستودع match بوضع readonly
#   fastlane beta                  بناء موقّع + رفع إلى TestFlight
#   fastlane bootstrap_signing     تشغيل لمرة واحدة: تسجيل التطبيق + توليد الشهادات
#
# ────────────────────────────────────────────────────────────────────────
#  الأسرار المطلوبة (GitHub → Settings → Secrets and variables → Actions)
# ────────────────────────────────────────────────────────────────────────
#   TEAM_ID                       Team ID من developer.apple.com → Membership
#   APP_STORE_CONNECT_KEY_ID      معرّف مفتاح API (10 محارف)
#   APP_STORE_CONNECT_ISSUER_ID   Issuer ID (صيغة UUID)
#   APP_STORE_CONNECT_KEY_P8      محتوى ملف .p8 كاملاً (أو مُرمَّزاً base64)
#   MATCH_PASSWORD                عبارة تشفير مخزن الشهادات
#   MATCH_GIT_TOKEN               PAT بصلاحية repo للوصول لمستودع certificates
#   MATCH_GIT_URL                 (اختياري) رابط مستودع الشهادات

require "base64"
require "fileutils"

APP_IDENTIFIER = "com.m-s-jaber.whatsx"
SCHEME         = "WhatsX"
APP_NAME       = "WhatsX"

# fastlane ينفّذ الأوامر من داخل مجلد fastlane/ لا من جذر المستودع، وهذا
# مصدر أخطاء مسارات متكرر. نحسب الجذر مرة واحدة ونستخدم مسارات مطلقة في
# كل مكان، فلا يبقى أي التباس.
ROOT          = File.expand_path("..", __dir__)
PROJECT       = File.join(ROOT, "WhatsX.xcodeproj")
BUILD_DIR     = File.join(ROOT, "build")
ARCHIVE_PATH  = File.join(BUILD_DIR, "#{SCHEME}.xcarchive")

default_platform(:ios)

platform :ios do
  before_all do
    # داخل CI ننشئ keychain مؤقتاً معزولاً للبناء. بدونه يفشل استيراد
    # الشهادات لأن الـ runner لا يملك keychain مفتوحاً.
    setup_ci if ENV["CI"]
  end

  # ══════════════════════════════════════════════════════════════════════
  # بناء غير موقّع — للتحقق السريع من أن الكود يُترجم ويُؤرشف
  # ══════════════════════════════════════════════════════════════════════
  # لا يحتاج أي سر ولا حساب Apple مفعّلاً. يُنتج .ipa غير موقّع صالح
  # لإعادة التوقيع عبر AltStore أو Sideloadly — وهو طريقك الوحيد للتجربة
  # على جهاز حقيقي قبل أن يُفعَّل حساب المطوّر.
  desc "بناء غير موقّع للتحقق السريع"
  lane :build do
    generate_project

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      skip_package_ipa: true,
      skip_codesigning: true,
      destination: "generic/platform=iOS",
      archive_path: ARCHIVE_PATH,
      xcargs: "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=''"
    )

    # gym لا يستطيع تصدير ipa بلا توقيع، فنغلّف الـ .app يدوياً بالبنية
    # التي يتوقعها iOS: Payload/<App>.app داخل أرشيف zip بامتداد ipa.
    package_unsigned_ipa
  end

  # ══════════════════════════════════════════════════════════════════════
  # سحب الشهادات — يُستدعى داخل CI قبل أي بناء موقّع
  # ══════════════════════════════════════════════════════════════════════
  desc "سحب شهادات match بوضع readonly (للاستخدام داخل CI)"
  lane :setup_certificates do
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: true,                       # لا ينشئ ولا يعدّل — يسحب فقط
      git_url: match_git_url,
      git_basic_authorization: match_git_auth,
      api_key: appstore_api_key,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )
  end

  # ══════════════════════════════════════════════════════════════════════
  # بناء موقّع + رفع إلى TestFlight
  # ══════════════════════════════════════════════════════════════════════
  desc "بناء موقّع ورفعه إلى TestFlight"
  lane :beta do
    setup_certificates
    generate_project

    # رقم البناء يجب أن يكون فريداً ومتصاعداً تحت نفس MARKETING_VERSION،
    # وإلا ترفض Apple الرفع. رقم تشغيل الـ workflow يضمن ذلك تلقائياً.
    increment_build_number(
      xcodeproj: PROJECT,
      build_number: ENV["BUILD_NUMBER"] || ENV["GITHUB_RUN_NUMBER"] || "1"
    )

    # توقيع يدوي صريح: نمنع Xcode من محاولة التوقيع التلقائي، الذي يفشل
    # داخل CI لأنه يتطلب حساباً مسجّلاً في Xcode.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: PROJECT,
      team_id: ENV["TEAM_ID"],
      targets: [SCHEME],
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore #{APP_IDENTIFIER}"
    )

    gym(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: BUILD_DIR,
      output_name: "#{SCHEME}.ipa",
      destination: "generic/platform=iOS",
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => "match AppStore #{APP_IDENTIFIER}"
        }
      }
    )

    upload_to_testflight(
      api_key: appstore_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: File.join(BUILD_DIR, "#{SCHEME}.ipa"),
      # لا ننتظر انتهاء معالجة Apple للبناء — قد تستغرق وقتاً طويلاً
      # ويستهلك دقائق runner بلا فائدة.
      skip_waiting_for_build_processing: true,
      # التوزيع الداخلي لا يستلزم مراجعة Beta App Review.
      distribute_external: false,
      changelog: ENV["CHANGELOG"] || "بناء آلي من فرع #{git_branch_name}"
    )
  end

  # ══════════════════════════════════════════════════════════════════════
  # تشغيل لمرة واحدة — بعد تفعيل حساب المطوّر مباشرة
  # ══════════════════════════════════════════════════════════════════════
  # هذا هو الـ lane الذي يحل مشكلة "لا أملك Mac": التشغيل الأول لـ match
  # يحتاج صلاحية الكتابة لتوليد الشهادات، وعادة يُنفَّذ على جهاز المطوّر.
  # هنا ننفّذه داخل runner من GitHub Actions بدل ذلك.
  #
  # شغّله من: Actions → ios-certificates → Run workflow
  # ولا تعده بعد نجاحه — الشهادات تُخزَّن وتُعاد للأبد عبر setup_certificates.
  desc "تشغيل أولي: تسجيل التطبيق في البوابة + توليد الشهادات وتخزينها"
  lane :bootstrap_signing do
    # produce لا يملك معامل api_key — يقرأ المفتاح من سياق الـ lane الذي
    # تملؤه app_store_connect_api_key. استدعاء الدالة هنا يضمن ذلك قبله.
    appstore_api_key

    # 1) تسجيل معرّف الحزمة في بوابة المطورين وإنشاء سجل التطبيق في
    #    App Store Connect. match لا ينشئ معرّف الحزمة بنفسه.
    begin
      produce(
        app_identifier: APP_IDENTIFIER,
        app_name: APP_NAME,
        # صيغة اللغة عند produce هي رمز locale لا اسم اللغة.
        language: "ar-SA",
        app_version: "1.13.0",
        sku: "whatsx-ios-#{APP_IDENTIFIER.gsub('.', '-')}",
        team_id: ENV["TEAM_ID"],
        # التطبيق مجاني ويُنشر بنموذج B2B — لا حاجة لاتفاقية Paid Apps.
        skip_itc: false,
        skip_devcenter: false
      )
    rescue => e
      # إن كان التطبيق مسجّلاً مسبقاً فهذا ليس خطأ — نكمل إلى توليد الشهادات.
      UI.important("تخطّي produce: #{e.message}")
    end

    # 2) توليد شهادة التوزيع وملف التزويد وتخزينهما مشفَّرَين في مستودع
    #    الشهادات. readonly: false هو الفارق الجوهري عن setup_certificates.
    match(
      type: "appstore",
      app_identifier: APP_IDENTIFIER,
      readonly: false,
      git_url: match_git_url,
      git_basic_authorization: match_git_auth,
      api_key: appstore_api_key,
      keychain_name: ENV["MATCH_KEYCHAIN_NAME"] || "fastlane_tmp_keychain",
      keychain_password: ENV["MATCH_KEYCHAIN_PASSWORD"] || ""
    )

    UI.success("تم. مستودع الشهادات صار جاهزاً — لا تشغّل هذا الـ lane مجدداً.")
  end

  # ══════════════════════════════════════════════════════════════════════
  # دوال مساعدة
  # ══════════════════════════════════════════════════════════════════════

  # يولّد WhatsX.xcodeproj من project.yml. ملف المشروع لا يُرفع للمستودع،
  # بل يُبنى في كل مرة — وهذا ما يغنيك عن Xcode محلياً.
  private_lane :generate_project do
    Dir.chdir(ROOT) { sh("xcodegen", "generate") }
    UI.user_error!("فشل توليد #{PROJECT}") unless Dir.exist?(PROJECT)
  end

  # مفتاح App Store Connect API. نقبل محتوى .p8 خاماً أو مُرمَّزاً base64،
  # ونكتشف الصيغة تلقائياً — لأن اللصق المباشر من الآيباد أسهل من الترميز.
  def appstore_api_key
    @api_key ||= begin
      raw = ENV["APP_STORE_CONNECT_KEY_P8"].to_s
      UI.user_error!("APP_STORE_CONNECT_KEY_P8 غير مضبوط") if raw.strip.empty?

      is_base64 = !raw.include?("BEGIN PRIVATE KEY")

      app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
        key_content: raw,
        is_key_content_base64: is_base64,
        in_house: false               # حساب فردي، ليس Enterprise
      )
    end
  end

  # سر MATCH_GIT_URL اختياري، لكن الـ workflow يمرره دائماً — فإن لم يُضف
  # يصل نصاً فارغاً لا nil، والفارغ في Ruby قيمة صادقة تتجاوز || وتجعل
  # match ينفّذ git clone '' فيفشل. الفحص الصريح للفراغ يعيد الافتراضي.
  def match_git_url
    url = ENV["MATCH_GIT_URL"].to_s.strip
    url.empty? ? "https://github.com/M-S-JABER/certificates" : url
  end

  # مصادقة HTTPS لمستودع الشهادات الخاص. نستخدم PAT بدل مفتاح SSH لأن
  # حفظ مفتاح SSH في أسرار GitHub أعقد وأهش.
  def match_git_auth
    token = ENV["MATCH_GIT_TOKEN"].to_s
    UI.user_error!("MATCH_GIT_TOKEN غير مضبوط") if token.strip.empty?
    Base64.strict_encode64("x-access-token:#{token}")
  end

  def git_branch_name
    ENV["GITHUB_REF_NAME"] || "local"
  end

  # يغلّف الـ .app الناتج عن الأرشيف في ملف .ipa غير موقّع، بالبنية التي
  # يتوقعها iOS: Payload/<App>.app داخل أرشيف zip بامتداد ipa.
  def package_unsigned_ipa
    app     = File.join(ARCHIVE_PATH, "Products/Applications/#{SCHEME}.app")
    payload = File.join(BUILD_DIR, "Payload")
    ipa     = File.join(BUILD_DIR, "#{SCHEME}-unsigned.ipa")

    UI.user_error!("لم يُعثر على حزمة التطبيق في #{app}") unless Dir.exist?(app)

    FileUtils.rm_rf(payload)
    FileUtils.mkdir_p(payload)
    FileUtils.cp_r(app, payload)
    FileUtils.rm_f(ipa)

    # zip يجب أن يُنفَّذ من داخل build/ ليكون المسار داخل الأرشيف
    # Payload/<App>.app وليس مساراً مطلقاً.
    Dir.chdir(BUILD_DIR) { sh("zip", "-qry", ipa, "Payload") }

    UI.success("تم إنتاج #{ipa}")
  end
end
