# هوية التطبيق والحساب. لا تضع هنا أي سر — كل القيم الحسّاسة تأتي من
# أسرار GitHub (Settings → Secrets and variables → Actions).

# معرّف الحزمة. يجب أن يطابق PRODUCT_BUNDLE_IDENTIFIER في project.yml
# وأن يكون مسجّلاً في بوابة المطورين (يسجّله lane :bootstrap_signing تلقائياً).
app_identifier("com.m-s-jaber.whatsx")

# Team ID: سلسلة من 10 محارف. مصدرها بعد تفعيل الحساب:
#   developer.apple.com → Account → Membership details → Team ID
# تُحفظ كسر باسم TEAM_ID.
team_id(ENV["TEAM_ID"].to_s)

# لا نضع apple_id عمداً. المصادقة تتم حصراً عبر App Store Connect API Key
# (ملف .p8)، وهو أسلوب لا يتطلب كلمة مرور ولا رمز مصادقة ثنائية — وهذا
# شرط أساسي للعمل داخل CI بلا تدخل بشري.
