<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>ar</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDisplayName</key>
    <string>WhatsX</string>
    <key>CFBundleName</key>
    <string>WhatsX</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <!-- iPad multitasking (Split View / Slide Over) requires all four
         orientations; iPhone stays portrait-only above. -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <true/>
    <!-- Permissions used by the app -->
    <key>NSMicrophoneUsageDescription</key>
    <string>يُستخدم الميكروفون للمكالمات الصوتية وتسجيل الرسائل الصوتية.</string>
    <key>NSCameraUsageDescription</key>
    <string>تُستخدم الكاميرا لالتقاط صورة الملف الشخصي والوسائط.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>يُستخدم للوصول إلى الصور لإرسالها أو تعيين صورة الملف الشخصي.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>يُستخدم Face ID لقفل التطبيق وحماية محادثات العملاء.</string>
    <!-- HTTPS/TLS only — exempt encryption. Without this key every TestFlight
         build stalls in "Missing Compliance" until answered manually. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <!-- Keeps live call audio running when the screen locks or the app
         backgrounds mid-call. An Info.plist capability, not a signed
         entitlement — App Transfer stays unaffected. -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
</dict>
</plist>
